%% -*- mode: erlang -*-
%% The plugin is normally compiled inside the EMQX 4.4 tree (see
%% lib-extra/plugins), where eredis is already provided by the broker.
%% Keep this list empty so no second eredis version is pulled in.
{deps, []}.

{erl_opts, [debug_info]}.

{xref_checks, [undefined_function_calls, undefined_functions,
               deprecated_function_calls]}.

{cover_enabled, true}.
